{
  "name": "agent-connect-dpro",
  "description": "Messaging connectors, social publishing adapters and an embeddable social studio by Dpro.",
  "author": "Dpro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dpro-at/agent-connect.git"
  },
  "homepage": "https://github.com/Dpro-at/agent-connect#readme",
  "bugs": {
    "url": "https://github.com/Dpro-at/agent-connect/issues"
  },
  "license": "MIT",
  "keywords": [
    "telegram",
    "discord",
    "channels",
    "messaging",
    "agent",
    "dpro"
  ],
  "version": "0.3.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./telegram": {
      "types": "./dist/telegram.d.ts",
      "import": "./dist/telegram.js"
    },
    "./discord": {
      "types": "./dist/discord.d.ts",
      "import": "./dist/discord.js"
    },
    "./python": {
      "types": "./dist/python.d.ts",
      "import": "./dist/python.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./social": {
      "types": "./dist/social.d.ts",
      "import": "./dist/social.js"
    },
    "./facebook": {
      "types": "./dist/facebook.d.ts",
      "import": "./dist/facebook.js"
    },
    "./instagram": {
      "types": "./dist/instagram.d.ts",
      "import": "./dist/instagram.js"
    },
    "./linkedin": {
      "types": "./dist/linkedin.d.ts",
      "import": "./dist/linkedin.js"
    },
    "./x": {
      "types": "./dist/x.d.ts",
      "import": "./dist/x.js"
    },
    "./youtube": {
      "types": "./dist/youtube.d.ts",
      "import": "./dist/youtube.js"
    },
    "./tiktok": {
      "types": "./dist/tiktok.d.ts",
      "import": "./dist/tiktok.js"
    },
    "./studio": {
      "types": "./studio/index.d.ts",
      "import": "./studio/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "NOTICE.md",
    "docs/brand/channels/*.svg",
    "docs/USAGE.md",
    "docs/CHANNELS.md",
    "licenses/*.txt",
    "runtime/cli.mjs",
    "runtime/python/catalog.json",
    "runtime/python/*.py",
    "runtime/python/requirements*.txt",
    "runtime/python/vendor/**/*.py",
    "runtime/python/vendor/**/*.yaml",
    "runtime/python/vendor/**/*.yml",
    "runtime/python/vendor/**/*.json",
    "runtime/python/vendor/**/*.js",
    "runtime/python/vendor/**/*.mjs",
    "runtime/python/vendor/**/*.ts",
    "studio"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "demo": "node demo/server.mjs"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "grammy": "^1.40.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "agent-connect": "runtime/cli.mjs"
  }
}
