{
  "name": "agent-connect-dpro",
  "description": "Reusable messaging and webhook connectors by Dpro, with 33 bundled integrations and an optional isolated Python runtime.",
  "author": "Dpro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dpro-at/agent-connect.git"
  },
  "homepage": "https://github.com/Dpro-at/agent-connect#readme",
  "bugs": {
    "url": "https://github.com/Dpro-at/agent-connect/issues"
  },
  "license": "MIT",
  "keywords": [
    "telegram",
    "discord",
    "channels",
    "messaging",
    "agent",
    "dpro"
  ],
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./telegram": {
      "types": "./dist/telegram.d.ts",
      "import": "./dist/telegram.js"
    },
    "./discord": {
      "types": "./dist/discord.d.ts",
      "import": "./dist/discord.js"
    },
    "./python": {
      "types": "./dist/python.d.ts",
      "import": "./dist/python.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "NOTICE.md",
    "docs/brand/channels/*.svg",
    "docs/USAGE.md",
    "docs/CHANNELS.md",
    "licenses/*.txt",
    "runtime/cli.mjs",
    "runtime/python/catalog.json",
    "runtime/python/*.py",
    "runtime/python/requirements*.txt",
    "runtime/python/vendor/**/*.py",
    "runtime/python/vendor/**/*.yaml",
    "runtime/python/vendor/**/*.yml",
    "runtime/python/vendor/**/*.json",
    "runtime/python/vendor/**/*.js",
    "runtime/python/vendor/**/*.mjs",
    "runtime/python/vendor/**/*.ts"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "grammy": "^1.40.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "agent-connect": "runtime/cli.mjs"
  }
}
